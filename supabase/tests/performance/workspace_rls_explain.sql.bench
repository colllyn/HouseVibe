-- =============================================================================
-- workspace_rls_explain.sql -- RLS Performance Benchmark (PostgreSQL 17)
-- =============================================================================
-- Generates 100,000+ workspace_members rows and validates index usage
-- for queries used in RLS policies. All data rolled back after test.
-- =============================================================================

BEGIN;

\echo ''
\echo '========================================'
\echo ' RLS Performance Benchmark'
\echo '========================================'

-- Suppress NOTICE noise
SET LOCAL client_min_messages TO WARNING;

-- =============================================================================
-- Setup: Create synthetic users and workspaces
-- =============================================================================

-- Create 1,000 synthetic profiles and auth users
INSERT INTO auth.users (id, email, raw_user_meta_data, raw_app_meta_data, aud, role, encrypted_password, created_at, updated_at)
SELECT
  ('00000000-0000-0000-0000-' || LPAD(i::text, 12, '0'))::uuid,
  'perf-user-' || i || '@example.invalid',
  jsonb_build_object('full_name', 'Perf User ' || i),
  '{}'::jsonb,
  'authenticated', 'authenticated', '', now(), now()
FROM generate_series(1, 1000) AS i
ON CONFLICT (id) DO NOTHING;

-- Create 100 synthetic workspaces
INSERT INTO public.workspaces (id, name, owner_user_id, city, business_type)
SELECT
  ('a0000000-0000-0000-0000-' || LPAD(i::text, 12, '0'))::uuid,
  'Perf Workspace ' || i,
  ('00000000-0000-0000-0000-' || LPAD(i::text, 12, '0'))::uuid,
  'PerfCity', 'residential_lease'
FROM generate_series(1, 100) AS i;

-- Create 100,000+ workspace_members rows
-- Each of the 100 workspaces gets ~1,000 members
INSERT INTO public.workspace_members (id, workspace_id, user_id, role, status)
SELECT
  gen_random_uuid(),
  ('a0000000-0000-0000-0000-' || LPAD(ws::text, 12, '0'))::uuid,
  ('00000000-0000-0000-0000-' || LPAD(member::text, 12, '0'))::uuid,
  CASE WHEN member = ws THEN 'owner'::public.workspace_role ELSE 'member'::public.workspace_role END,
  'active'::public.member_status
FROM generate_series(1, 100) AS ws,
     generate_series(1, 1000) AS member
WHERE member <= 1000;

\echo 'Data generated. Counting rows...'

-- Verify row counts
SELECT 'workspaces' AS entity, count(*) AS rows FROM public.workspaces
UNION ALL
SELECT 'workspace_members', count(*) FROM public.workspace_members;

-- Update statistics for accurate planner decisions
ANALYZE public.workspace_members;
ANALYZE public.workspaces;

\echo 'Statistics updated.'

-- =============================================================================
-- Scenario A: Composite member lookup (workspace_id + user_id)
-- Used by: is_workspace_member helper, RLS policy first branch
-- Expected: Index Scan on workspace_members unique index
-- =============================================================================
\echo ''
\echo '=== Scenario A: Member lookup by (workspace_id, user_id) ==='
EXPLAIN (ANALYZE, BUFFERS, COSTS, SUMMARY)
SELECT 1 FROM public.workspace_members
WHERE workspace_id = 'a0000000-0000-0000-0000-000000000050'::uuid
  AND user_id = '00000000-0000-0000-0000-000000000500'::uuid;

-- =============================================================================
-- Scenario B: User workspace list (user_id + status)
-- Used by: Reverse lookup — "show me all my workspaces"
-- Expected: Index Scan on idx_workspace_members_user_workspace_status
-- =============================================================================
\echo ''
\echo '=== Scenario B: User workspace list (user_id + status) ==='
EXPLAIN (ANALYZE, BUFFERS, COSTS, SUMMARY)
SELECT workspace_id FROM public.workspace_members
WHERE user_id = '00000000-0000-0000-0000-000000000500'::uuid
  AND status = 'active';

-- =============================================================================
-- Scenario C: Owner membership check (exists subquery)
-- Used by: workspace_members RLS UPDATE policy (WITH CHECK)
-- Expected: Index Scan on workspaces_pkey
-- =============================================================================
\echo ''
\echo '=== Scenario C: Owner check via workspaces table (RLS policy) ==='
EXPLAIN (ANALYZE, BUFFERS, COSTS, SUMMARY)
SELECT EXISTS (
  SELECT 1 FROM public.workspaces
  WHERE id = 'a0000000-0000-0000-0000-000000000050'::uuid
    AND owner_user_id = '00000000-0000-0000-0000-000000000050'::uuid
);

-- =============================================================================
-- Scenario D: Owner views all members of a workspace
-- Used by: Owner managing workspace members
-- Expected: Index Scan on workspace_members unique index (leading column workspace_id)
-- =============================================================================
\echo ''
\echo '=== Scenario D: Owner reads all workspace members ==='
EXPLAIN (ANALYZE, BUFFERS, COSTS, SUMMARY)
SELECT user_id, role, status FROM public.workspace_members
WHERE workspace_id = 'a0000000-0000-0000-0000-000000000050'::uuid;

-- =============================================================================
-- Verification: No Seq Scan on large membership table (PostgreSQL 17)
-- =============================================================================
\echo ''
\echo '=== Verification: Check for Seq Scan avoidance ==='

-- Use EXPLAIN in text mode and pg_plan_advice or manual parse
-- Just run a simple EXPLAIN to verify index usage visually
EXPLAIN (ANALYZE false, BUFFERS, COSTS)
SELECT 1 FROM public.workspace_members
WHERE workspace_id = 'a0000000-0000-0000-0000-000000000050'::uuid
  AND user_id = '00000000-0000-0000-0000-000000000500'::uuid;

-- Also verify the user+status reverse lookup uses index
\echo ''
\echo '=== Verification: User reverse lookup ==='
EXPLAIN (ANALYZE false, BUFFERS, COSTS)
SELECT workspace_id FROM public.workspace_members
WHERE user_id = '00000000-0000-0000-0000-000000000500'::uuid
  AND status = 'active';

\echo ''
\echo '========================================'
\echo ' Performance Benchmark Complete'
\echo '========================================'

ROLLBACK;
