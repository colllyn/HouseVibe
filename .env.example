# =============================================================================
# HouseVibe Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase Public (NEXT_PUBLIC_*) -- safe to expose to browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase Server Secrets -- NEVER expose to browser
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ---------------------------------------------------------------------------
# DeepSeek Text Model (ai-contract v2.0, model核验 2026-08-03)
# Primary = deepseek-v4-flash (lower latency/cost, structured extraction)
# Fallback = deepseek-v4-pro (higher reasoning; only used on retryable failures)
# All text model vars are optional — app starts without them; AI calls fail-closed
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# DeepSeek Vision Model (independent deployment; P3-AI-005 only)
# All vision vars are optional — text Provider does not depend on them
# ---------------------------------------------------------------------------
# DEEPSEEK_VISION_BASE_URL_PRIMARY=your-vision-service-primary-url-here
# DEEPSEEK_VISION_BASE_URL_FALLBACK=your-vision-service-fallback-url-here
# DEEPSEEK_VISION_API_KEY=your-vision-api-key-here
# DEEPSEEK_VISION_MODEL=deepseek-vl2
# DEEPSEEK_VISION_MAX_IMAGES=8

# ---------------------------------------------------------------------------
# STT (Speech-to-Text) -- independent subsystem
# ---------------------------------------------------------------------------
STT_BASE_URL=your-stt-service-url-here
STT_API_KEY=your-stt-api-key-here
TRANSCRIPTION_PROVIDER=
MAX_AUDIO_DURATION_SECONDS=60
MAX_AUDIO_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Quota and Cost Controls
# ---------------------------------------------------------------------------
AI_DAILY_CONTENT_LIMIT=10
AI_DAILY_COST_LIMIT_USD=10.00
AI_PREFERENCE_MIN_EVIDENCE=3
AI_FAILURE_THRESHOLD=3
AI_FAILURE_WINDOW_SECONDS=300
AI_QUOTA_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------------------
# Invite Token
# ---------------------------------------------------------------------------
INVITE_TOKEN_SECRET=your-invite-token-secret-at-least-32-characters-here

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-here
COMPLIANCE_BLOCK_COPY=true
INITIAL_SYSTEM_ADMIN_EMAIL=your-admin-email@example.com
